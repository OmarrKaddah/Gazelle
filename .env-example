# ============================================
# NER Configuration
# ============================================
# Choose NER strategy: 'gliner', 'llm', or 'hybrid'
NER_STRATEGY=hybrid

# GLiNER model to use when NER_STRATEGY is gliner or hybrid
# Arabic-focused default:
GLINER_MODEL=NAMAA-Space/gliner_arabic-v2.1

# Multi-lingual alternative for mixed Arabic/English documents:
# GLINER_MODEL=urchade/gliner_multi

# GLiNER confidence threshold
GLINER_THRESHOLD=0.5

# ============================================
# Ollama / Local LLM Configuration
# ============================================
# Ollama chat completions endpoint
OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Local model used for entity extraction and relationships
# Good starting points for 2x5090:
# OLLAMA_TEXT_MODEL=qwen2.5:72b-instruct-q4_K_M
# OLLAMA_TEXT_MODEL=llama3.1:70b-instruct-q4_K_M
OLLAMA_TEXT_MODEL=qwen2.5:72b-instruct-q4_K_M

# Number of parallel chunks for Ollama calls
OLLAMA_NUM_PARALLEL=4

# ============================================
# Neo4j Configuration
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ============================================
# Embeddings Configuration
# ============================================
BGE_M3_PATH=BAAI/bge-m3
HF_HUB_OFFLINE=1

# ============================================
# Database Configuration
# ============================================
# Airgapped build: SQLite only (no Postgres / asyncpg). Optional — defaults to ./gazelle.db if unset.
DATABASE_URL=sqlite+aiosqlite:///./gazelle.db

# ============================================
# Other LLM Providers
# ============================================
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# ============================================
# Pipeline Configuration
# ============================================
CHUNKER_TYPE=default
SKIP_KG=false
SKIP_EMBED=false
SKIP_OCR=false# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Database — SQLite only (airgapped build)
DATABASE_URL=sqlite+aiosqlite:///./gazelle.db

# LLM Providers
OLLAMA_URL=http://localhost:11434/v1/chat/completions
OLLAMA_EXTRACT_MODEL=gemma3:1b
OLLAMA_CHAT_MODEL=gemma3:1b
PARALLEL_CHUNKS=4
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Embeddings
BGE_M3_PATH=BAAI/bge-m3
HF_HUB_OFFLINE=1
