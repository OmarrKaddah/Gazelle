# ============================================
# CORE SETUP — GRAPH CONSTRUCTION ROUTE
# ============================================
# Route 1: Classical (GLiNER + co-mention COOCCURS_WITH edges)
#   - Deterministic, local-retrieval only, no descriptions
# Route 2: LLM full-graph (entities + RELATED edges with descriptions)
#   - Deployed default; required for global/community arm
# Override per-run with GRAPH_ROUTE env var
GRAPH_ROUTE=2

# ============================================
# PROJECT CONFIGURATION
# ============================================
# Directory for all extraction JSONs (entities + graph relationships)
EXTRACT_DIR=extractions

# Corpus name tag for Community nodes and global queries
CORPUS_NAME=cbe

# Cosine similarity threshold for SYNONYM identity-bridging edges
SYNONYM_THRESHOLD=0.85

# Leiden community detection resolution (higher = more, smaller communities)
COMMUNITY_RESOLUTION=1.0

# ============================================
# NEO4J CONFIGURATION
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DB=neo4j

# ============================================
# DATABASE CONFIGURATION
# ============================================
# SQLite (airgapped build — no Postgres required)
# Default: ./gazelle.db (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///./gazelle.db

# ============================================
# OCR CONFIGURATION
# ============================================
# OCR provider: 'ollama' (default) or other supported backends
OCR_PROVIDER=ollama

# Number of parallel pages to process during OCR
OCR_PARALLEL_PAGES=1

# Vision model for OCR (must be available in Ollama)
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct-q4_K_M

# ============================================
# HANDWRITING PREPROCESSING (Optional)
# ============================================
# Enable preprocessing to remove handwritten text before OCR
# Set to 'true' or '1' to enable (requires trained model)
HANDWRITING_PREPROCESSING=false

# Path to trained handwriting detector model
HANDWRITING_MODEL_PATH=models/handwriting_removal.joblib

# Patch size for handwriting detection (pixels)
HANDWRITING_PATCH_SIZE=48

# Stride between patches (pixels)
HANDWRITING_PATCH_STRIDE=24

# Number of patches to extract per image
HANDWRITING_PATCHES_PER_IMAGE=256

# Confidence threshold for handwriting classification (0.0-1.0)
HANDWRITING_THRESHOLD=0.7

# ============================================
# CHUNKING CONFIGURATION
# ============================================
# Chunker type: 'default' (fixed token window) or 'semantic' (boundary-aware)
CHUNKER_TYPE=semantic

# Target token count per chunk
CHUNK_TARGET_TOKENS=600

# ============================================
# ENTITY EXTRACTION (NER) CONFIGURATION
# ============================================
# NER strategy: 'gliner' (default), 'classical' (CRF), or 'llm'
NER_STRATEGY=gliner

# GLiNER Arabic model path or identifier
GLINER_MODEL=NAMAA-Space/gliner_arabic-v2.1

# GLiNER multilingual model (for mixed Arabic/English documents)
GLINER_MODEL_EN=urchade/gliner_multi-v2.1

# GLiNER confidence threshold for entity extraction (0.0-1.0)
GLINER_THRESHOLD=0.7

# ============================================
# GRAPH EXTRACTION (ROUTE 2) CONFIGURATION
# ============================================
# Backend for LLM graph extraction: 'openrouter', 'groq', 'ollama', or 'gemini'
GRAPH_EXTRACT_BACKEND=openrouter

# Number of parallel workers for Route 2 chunk processing
GRAPH_EXTRACT_WORKERS=12

# Model for relation extraction (used with OLLAMA backend)
OLLAMA_EXTRACT_MODEL=llama3.1:8b

# Number of parallel chunk extraction requests
PARALLEL_CHUNKS=4

# ============================================
# OLLAMA CONFIGURATION
# ============================================
# Ollama chat completions endpoint
OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Ollama embedding endpoint
OLLAMA_EMBED_URL=http://localhost:11434/api/embed

# Chat model for answer generation
OLLAMA_CHAT_MODEL=llama3.1:8b

# Embedding model (multilingual, handles Arabic + English)
OLLAMA_EMBED_MODEL=bge-m3

# llama-server alternative endpoint (if using llama-cpp-python)
LLAMA_SERVER_URL=http://localhost:8080/v1/chat/completions

# ============================================
# GROQ CONFIGURATION (Optional Cloud LLM)
# ============================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# OPENROUTER CONFIGURATION (For Route 2 Graph Extraction)
# ============================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ============================================
# GOOGLE GEMINI CONFIGURATION (Optional)
# ============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================
# EMBEDDING CONFIGURATION
# ============================================
# BGE-M3 model path (HuggingFace or local path)
BGE_M3_PATH=BAAI/bge-m3

# Embedding dimension (BGE-M3 uses 1024)
EMBED_DIM=1024

# Batch size for chunk embedding
CHUNK_EMBED_BATCH=16

# Batch size for entity embedding
ENTITY_EMBED_BATCH=32

# ============================================
# CHAT API CONFIGURATION
# ============================================
# Domain framing for system prompt: 'compliance' (CBE/banking) or 'general'
CHAT_DOMAIN=compliance

# ============================================
# ENTITY ALIGNMENT CONFIGURATION
# ============================================
# Cosine similarity threshold for deduplication (0.0-1.0, higher = stricter)
SIM_THRESHOLD=0.92

# Entity types to skip during deduplication (comma-separated)
# Example: SKIP_SIM_TYPES=Date,MonetaryAmount
SKIP_SIM_TYPES=Date,MonetaryAmount

# ============================================
# RETRIEVAL TUNING (Advanced)
# ============================================
# Reciprocal Rank Fusion constant for hybrid retrieval
RRF_K=60

# Overfetch multiplier: pull k*OVERFETCH from index before access-control filtering
OVERFETCH=4

# Graph traversal depth for PPR retrieval
PATH_DEPTH=3

# Number of top entities to seed in PPR (Personalized PageRank)
SEED_K=8

# Maximum number of edges to traverse per path
PATH_LIMIT=300

# Number of top relationship types to use
REL_TYPE_TOP=5

# Floor threshold for relationship type scores
REL_TYPE_FLOOR=0.25

# Weight for entity similarity vs relationship similarity in path scoring
# (0.6 means: 60% entity_similarity + 40% relationship_similarity)
ENTITY_WEIGHT=0.6

# Enable co-mention edges walk in graph mode (Route 1 graphs only)
# Set to 'true' or '1' to use COOCCURS_WITH edges in traversal
LOCAL_COMENTION_EDGES=false

# ============================================
# HUGGINGFACE CONFIGURATION (Optional)
# ============================================
# Offline mode for HuggingFace (if models are pre-cached)
# Set to '1' to prevent automatic downloads
HF_HUB_OFFLINE=0

# ============================================
# OPTIONAL: DEVELOPMENT & DEBUGGING
# ============================================
# Set to 'true' or '1' for debug logging
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
