Documents/
musique/data

# =====================================================================
# Project: pipeline-derived data (regenerable, but expensive)
# Ignore the directories by default; explicitly allow the MuSiQue
# artifacts that took hours to extract (entities, triples, chunks)
# so they're part of the thesis-reproducible record.
# =====================================================================
Doc_Out/
output/
parsed/

# chunks/ and extractions/ — ignore contents by default, allowlist
# the thesis-critical MuSiQue artifacts so they're in the repo record.
chunks/*
extractions/*

!chunks/musique.json
!extractions/musique_entities.json
!extractions/musique_triples.json
chunks/
extractions/

# =====================================================================
# Project: eval results (regenerable; gold/ is hand-curated and kept)
# =====================================================================
eval/results.json

