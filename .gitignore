/_*.txt

# Throwaway probe scripts at project root (not in src/ or runners/)
/test.py
/scratch.py

# Session handoff — kept on disk for working memory, not in repo
/HANDOFF.md

# Local Claude config
.claude/
CLAUDE.md

# graphTraversal validation fixtures + generated figures (regenerable/downloadable)
graphTraversal/datasets/
graphTraversal/figures/

