# =====================================================================
# Project: source documents (potentially confidential)
# Comment this out if your corpus is public.
# =====================================================================
Documents/
musique/data

# =====================================================================
# Project: pipeline-derived data (regenerable, but expensive)
# Ignore the directories by default; explicitly allow the MuSiQue
# artifacts that took hours to extract (entities, triples, chunks)
# so they're part of the thesis-reproducible record.
# =====================================================================
Doc_Out/
output/
parsed/

# chunks/ and extractions/ — ignore contents by default, allowlist
# the thesis-critical MuSiQue artifacts so they're in the repo record.
chunks/*
extractions/*

!chunks/musique.json
!extractions/musique_entities.json
!extractions/musique_triples.json

# =====================================================================
# Misc
# =====================================================================
*.tmp
*.bak
plans/
.ini

# Stray clipboard / WhatsApp images at project root
WhatsApp Image *.jpeg
WhatsApp Image *.jpg
WhatsApp Image *.png

# Throwaway probe scripts at project root (not in src/ or runners/)
/test.py
/scratch.py

# Session handoff — kept on disk for working memory, not in repo
/HANDOFF.md

# Local Claude config
.claude/

# graphTraversal validation fixtures + generated figures (regenerable/downloadable)
graphTraversal/datasets/
graphTraversal/figures/

# =====================================================================
# Local-only — developer machine convenience, never push (keep on laptop)
# =====================================================================
# Windows launcher / helper scripts
*.bat
*.ps1
bootstrap.py
inspect_memory.py

# Draft gitignore
.gitignore.new

# Local PostgreSQL data
.pgdata/

# Vite cache files
frontend/vite.config.js.timestamp-*.mjs

# Local docs / generated reports (HTML + Word) — not committed
docs/*.html
docs/*.docx

# Local sample/test fixtures
test_samples/

